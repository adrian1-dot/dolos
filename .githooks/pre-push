#!/bin/bash
# Abort push if local main is behind origin/main.
# A stale local main causes PRs to show unrelated commits in their diff.

remote="$1"

if [ "$remote" != "origin" ]; then
  exit 0
fi

git fetch origin main --quiet 2>/dev/null || true

BEHIND=$(git rev-list main..origin/main --count 2>/dev/null || echo 0)

if [ "$BEHIND" -gt 0 ]; then
  echo ""
  echo "  pre-push blocked: local main is $BEHIND commit(s) behind origin/main."
  echo "  Run: git checkout main && git pull --ff-only"
  echo "  Then rebase: git rebase origin/main"
  echo ""
  exit 1
fi

exit 0
